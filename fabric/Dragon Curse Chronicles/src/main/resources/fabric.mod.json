{
    "schemaVersion": 1,
    "id": "dcc",
    "version": "${version}",
    "name": "Dragon Curse Chronicles",
    "description": "Dragon Curse Chronicles: An epic mod inspired by Jackie Chan's Twelve Talismans.",
    "authors": [
        "QiTuo",
        "Yifei"
    ],
    "license": "MIT",
    "icon": "assets/dcc/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.qituo.dcc.DragonCurseChronicles"
        ],
        "client": [
            "com.qituo.dcc.client.ClientInit"
        ]
    },
    "accessWidener": "dcc.accessWidener",
    "mixins": [
        "dcc.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.16.13",
        "minecraft": "~1.20.1",
        "java": ">=17",
        "fabric-api": "*",
        "dcrapi": "*"
    }
}
